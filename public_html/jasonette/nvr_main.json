{
    "$jason": {
        "head": {
            "title": "Never Ready Records",
            "description": "An app for Never Ready Records hardcore fans. Yes, all 6 of you!",
            "icon": "http://gpcodes.com/jasonette/img/nvr-logo.png",
            "offline": "true",
            "styles": {
                "release_thumbnail": { "width": "132", "height": "132", "corner_radius": "2" },
                "release_artist": { "size": "18", "font": "AvenirNext-Medium" },
                "release_title": { "size": "14" },
                "release_catno": { "size": "10" },
                "artist_thumbnail": { "width": "96", "height": "96", "corner_radius": "2" },
                "artist_tiny_bio": { "size": "10" }
            },
            "actions": {
                "show_banner": {
                    "type": "$util.banner",
                    "options": { "title": "Artist Info Banner", "description": "Thanks for checking out {{ $jason.banner_artist }} 's profile page!" }
                },
                "$load": {
                    "type": "$network.request",
                    "options": { "url": "https://www.jasonbase.com/things/m8d.json" },
                    "success": { "type": "$render" }
                }
            },
            "templates": {
                "body": {
                    "style": { "background": "#FFFFFF", "border": "none", "font": "AvenirNext" },
                    "header": {
                        "title": { "type": "image", "style": { "width": "240", "height": "30" }, "url": "http://gpcodes.com/jasonette/img/bandcamp-header.png" },
                        "style": { "background": "#000000" }
                    },
                    "sections": [ 
                        {
                            "type": "horizontal",
                            "header": {
                                "type": "vertical",
                                "style": { "align": "center", "background": "#DDDDDD", "spacing": "4" },
                                "components": [ { "type": "label", "text": "Vinyl & Digital Releases" } ]
                            },
                            "items": {
                                "{{ #each $jason.releases }}": {
                                    "type": "vertical",
                                    "style": { "width": "160", "padding": "16", "background": "#ffffff", "align": "center", "height": "272" },
                                    "components": [
                                        { "type": "image", "class": "release_thumbnail", "url": "{{ image }}" },
                                        { "type": "label", "class": "release_artist", "text": "{{ artist }}" },
                                        { "type": "label", "class": "release_title", "text": "{{ title }}" },
                                        { "type": "space" },
                                        { "type": "button", "text": "Listen", "style": { "background": "#17BF63", "color": "#ffffff", "align": "center", "width": "150", "height": "40", "corner_radius": "2" },
                                            "action": { "type": "$audio.play", "options": { "url": "{{ snippet }}" } }
                                        }
                                    ]
                                }
                            }
                        },
                        {
                            "type": "horizontal",
                            "header": {
                                "type": "vertical",
                                "style": { "align": "center", "background": "#DDDDDD", "spacing": "4" },
                                "components": [ { "type": "label", "text": "Artists" } ]
                            },
                            "items": {
                                "{{ #each $jason.artists }}": {
                                    "type": "vertical",
                                    "style": { "width": "120", "padding": "12", "background": "#ffffff", "align": "center", "height": "300" },
                                    "href": { "url": "http://gpcodes.com/jasonette/{{ url_name }}.json" },
                                    "components": [
                                        { "type": "image", "class": "artist_thumbnail", "url": "{{ pic }}" },
                                        { "type": "space" , "style": { "height": "8" } },
                                        { "type": "label", "text": "{{ name }}" },
                                        { "type": "space" , "style": { "height": "8" } },
                                        { "type": "label", "class": "artist_tiny_bio", "text": "{{ tiny_bio }}" },
                                        { "type": "space" , "style": { "height": "12" } },
                                        { "type": "label", "text": "Full bio", "style": { "color": "#17BF63", "align": "center" } },
                                        { "type": "space" }
                                    ]
                                }
                            }
                        },
                        {
                            "type": "horizontal",
                            "header": {
                                "type": "vertical",
                                "style": { "align": "center", "background": "#DDDDDD" },
                                "components": [ { "type": "label", "text": "Videos" } ]
                            },
                            "items": [
                                {
                                    "type": "horizontal",
                                    "style": { "background": "#ff00ff", "width": "100%", "height": "280" },
                                    "components": [ 
                                        { "type": "label", "text": "Videos here" }, 
                                        { "type": "image", "url": "http://i.giphy.com/3FqHllASdLpmM.gif", "style": { "width": "100%" } } 
                                    ]
                                }
                            ]
                        },
                        {
                            "type": "horizontal",
                            "header": {
                                "type": "vertical",
                                "style": { "align": "center", "background": "#DDDDDD" },
                                "components": [ { "type": "label", "text": "Social" } ]
                            },
                            "style": { "spacing": "8" },
                            "items": {
                                "{{ #each $jason.nvr_social }}": {
                                    "type": "image",
                                    "url": "{{ social_icon }}", "href": { "url": "{{ nvr_social_url }}", "view": "web" }
                                }
                            }
                        },
                        {
                            "type": "horizontal",
                            "style": { "align": "center" },
                            "items": [
                                { 
                                    "type": "space" 
                                },
                                {
                                    "type": "label",
                                    "style": { "width": "100%", "height":"60" },
                                    "text": "neverreadyrecords.com",
                                    "href": { "url": "http://www.neverreadyrecords.com", "view": "web" }
                                }
                            ]
                        }
                    ]
                }
            }
        }
    }
}